rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isStudentNo(classId, no) {
      return request.auth != null && request.auth.token.get('role', '') == 'student'
        && request.auth.token.get('classId', '') == classId && string(request.auth.token.get('no', '')) == no;
    }
    function ownsClass(classId) {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/classes/$(classId)).data.teacherUid == request.auth.uid;
    }
    // AI가 만든 결과물: 서버만 쓴다
    match /classes/{classId}/{no}/gens/{file} {
      allow read: if isStudentNo(classId, no) || ownsClass(classId);
      allow write: if false;
    }
    // 학생이 올린 영상: 100MB 이하 영상만
    match /classes/{classId}/{no}/uploads/{file} {
      allow read: if isStudentNo(classId, no) || ownsClass(classId);
      allow create: if isStudentNo(classId, no)
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
      allow delete: if isStudentNo(classId, no);
      allow update: if false;
    }
    // 학생 목소리 녹음: 5MB 이하 소리 파일만
    match /classes/{classId}/{no}/voices/{file} {
      allow read: if isStudentNo(classId, no) || ownsClass(classId);
      allow create, update: if isStudentNo(classId, no)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if isStudentNo(classId, no);
    }
    // 완성 영상: 서버가 만든다. 본인·교사, 그리고 제출한 작품은 같은 반 친구도 볼 수 있다
    match /classes/{classId}/{no}/exports/{file} {
      allow read: if isStudentNo(classId, no) || ownsClass(classId)
        || (request.auth != null && request.auth.token.get('classId', '') == classId
            && firestore.get(/databases/(default)/documents/projects/$(classId + '_' + no)).data.submitted == true);
      allow write: if false;
    }
    match /{all=**} { allow read, write: if false; }
  }
}
