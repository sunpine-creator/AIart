# functions/.env 로 복사해서 쓰세요. (비밀값이 아니라 설정값만 둡니다)
# 영상 생성 방식: mock = 비용 없이 가짜 결과, omni = 실제 Gemini Omni 호출
VIDEO_PROVIDER=mock
# 가짜 모드에서도 Gemini 검사·번역을 쓰려면 on (Vertex AI 연결 필요)
TEXT_CHECK=off
# Vertex AI(Gemini Enterprise Agent Platform) 위치. Omni 미리보기는 global
GENAI_LOCATION=global
# 모델 이름은 콘솔의 Model Garden에서 확인하고 맞추세요
OMNI_MODEL=gemini-omni-flash-preview
TEXT_MODEL=gemini-2.5-flash
IMAGE_MODEL=gemini-2.5-flash-image
# 대기열이 한 번에 보내는 생성 요청 수 (프로젝트 할당량에 맞추기)
MAX_CONCURRENT=5
# 1초당 가격(USD). 가격이 바뀌면 여기만 고치면 됩니다
PRICE_360P=0.03
PRICE_720P=0.10
PRICE_IMAGE=0.04

# AI 목소리(TTS) 모델
TTS_MODEL=gemini-2.5-flash-preview-tts
